{
  typography = {
    interface = "IBM Plex Mono";
    monospace = "IBM Plex Mono";
    display = "DSEG7 Classic";

    sizes = {
      small = 10;
      medium = 12;
      large = 14;
      clockDigit = 58;
    };
  };

  geometry = {
    radius = 0;
    borderWidth = 1;

    gapInner = 5;
    gapOuter = 10;

    spacingSmall = 3;
    spacingMedium = 8;
  };

  motion = {
    enabled = true;
    widgetFadeMs = 120;
  };

  opacity = {
    widgetVisible = 1.0;
    widgetHidden = 0.0;
  };
}
